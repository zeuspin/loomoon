{
  "name": "@creoor/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "playwright test e2e/visual.spec.ts",
    "tokens:check": "node scripts/check-theme-tokens.mjs",
    "coverage:check-critical": "node scripts/check-critical-coverage.mjs",
    "acceptance:plan": "node ../scripts/check-creoor-acceptance.mjs --phase=plan",
    "acceptance:check": "node ../scripts/check-creoor-acceptance.mjs --phase=release",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "idb": "^8.0.0",
    "konva": "^10.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-konva": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "axe-core": "^4.10.0",
    "fake-indexeddb": "^6.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
